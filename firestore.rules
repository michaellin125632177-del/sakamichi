rules_version = '2';

// 坂道選拔名單 — Firestore 安全規則
//
// ※ 這個檔案只是版控用的副本，改它不會生效。
//   要到 Firebase Console → Firestore Database → 規則，貼上後按「發布」。

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == 'cHr53MtDS0OgfHm7xC9E1CVtbpA2';
    }

    function pollOpenFor(pid) {
      let p = get(/databases/$(database)/documents/polls/$(pid)).data;
      // settled 也要擋：結算之後才進來的注永遠領不到錢（結算只能跑一次），
      // 等於把人家的籌碼吃掉。前端已經擋了，這裡是第二道。
      return p.get('closed', false) == false
          && p.get('answer', '') == ''
          && p.get('settled', false) == false;
    }

    function validBet(bid) {
      let d = request.resource.data;
      return request.auth != null
        && bid == d.pollId + '_' + request.auth.uid
        && d.uid == request.auth.uid
        && d.keys().hasOnly(['pollId', 'uid', 'name', 'pick', 'stake', 'at'])
        && d.keys().hasAll(['pollId', 'uid', 'name', 'pick', 'stake', 'at'])
        && d.pick is string
        && d.name is string
        && d.name.size() <= 16
        && d.stake is int
        && d.stake > 0
        && d.at is number
        // 錢包那邊必須指回這一注，金額才會被核對到
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid))
             .data.lastBet == d.pollId
        && pollOpenFor(d.pollId)
        && d.pick in get(/databases/$(database)/documents/polls/$(d.pollId)).data.candidates;
    }

    // 「今天」一定要由伺服器時間算，不能信前端寫進來的字串。
    // 舊版只檢查「跟上次記的日期不同」，那等於每次換一個新字串就能再領
    // 一次，上限形同虛設。request.time 是伺服器時間（UTC），加 8 小時
    // 換成台灣時間，跟前端的 today() 用同一套算法。
    function twDay() {
      let t = request.time + duration.value(8, 'h');
      return string(t.year()) + '-'
           + (t.month() < 10 ? '0' : '') + string(t.month()) + '-'
           + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    // 測驗分數是在瀏覽器算的，規則沒辦法驗「你真的答對幾題」。
    // 所以這裡能保證的只有：一天最多領 3 次、每次最多 100、一天總共不超過
    // 300。擋不住有人宣稱滿分，但擋得住他把自己變成一億。
    function isQuizClaim() {
      let d = request.resource.data;
      let old = resource.data;
      let day = twDay();
      let first = old.get('quizDay', '') != day;   // 今天的第一次
      let gain = d.balance - old.balance;
      return d.diff(old).affectedKeys()
               .hasOnly(['balance', 'quizDay', 'quizGain', 'quizCount'])
          && d.quizDay == day                      // 只能寫伺服器當下的日期
          && d.balance is int
          && gain > 0
          && gain <= 100                           // 單次上限
          && d.quizCount is int
          && d.quizCount == (first ? 1 : old.get('quizCount', 0) + 1)
          && d.quizCount <= 3                      // 一天三次
          && d.quizGain is int
          && d.quizGain == (first ? gain : old.get('quizGain', 0) + gain)
          && d.quizGain <= 300;                    // 一天總額
    }

    function isBetDeduction(uid) {
      let d = request.resource.data;
      let old = resource.data;
      let bid = d.lastBet + '_' + uid;
      return d.diff(old).affectedKeys().hasOnly(['balance', 'lastBet'])
          && d.lastBet is string
          && d.balance is int
          && d.balance >= 0
          && d.balance < old.balance
          && existsAfter(/databases/$(database)/documents/bets/$(bid))
          && old.balance - d.balance
             == getAfter(/databases/$(database)/documents/bets/$(bid)).data.stake;
    }

    // ── 單曲與成員名冊：公開讀，只有站長能寫 ──
    match /nogi/{doc}    { allow read: if true; allow write: if isOwner(); }
    match /hinata/{doc}  { allow read: if true; allow write: if isOwner(); }
    match /sakura/{doc}  { allow read: if true; allow write: if isOwner(); }
    match /keyaki/{doc}  { allow read: if true; allow write: if isOwner(); }
    match /aoba/{doc}    { allow read: if true; allow write: if isOwner(); }
    match /members/{doc} { allow read: if true; allow write: if isOwner(); }

    // ── C 位預測 ──
    // 票數直接累加在 poll 文件的 tally，訪客讀 1 筆就看得到全部票數。
    // 代價是訪客得有權限改這筆文件，所以下面把「能改什麼」鎖到只剩投票這件事。
    match /polls/{pid} {

      // 這次 update 只碰了 tally、voteCount 與 pool，其他欄位一個都沒動
      function onlyTally() {
        return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['tally', 'voteCount', 'pool']);
      }
      // 彩池只能加上這個人這次押的金額
      function poolMatches(pid) {
        let b = getAfter(/databases/$(database)/documents/bets/$(pid + '_' + request.auth.uid)).data;
        return request.resource.data.get('pool', 0)
               == resource.data.get('pool', 0) + b.stake;
      }

      // 總票數剛好 +1，而且 tally 裡只有一個人的數字變動
      function bumpedOne() {
        return request.resource.data.voteCount == resource.data.voteCount + 1
            && request.resource.data.tally.diff(resource.data.tally)
               .affectedKeys().size() == 1;
      }

      // 變動的那個人，必須就是這位使用者在同一批次裡寫進去的那張票所投的人。
      // 用 getAfter 而不是 get：票與加票是同一個 batch，get 看到的是批次「之前」
      // 的狀態，那時候票還不存在。
      function matchesMyVote() {
        let v = getAfter(/databases/$(database)/documents/bets/$(pid + '_' + request.auth.uid)).data;
        return request.resource.data.tally.diff(resource.data.tally)
                 .affectedKeys().hasOnly([v.pick])
            && request.resource.data.tally[v.pick]
               == resource.data.tally.get(v.pick, 0) + 1
            && v.pollId == pid;
      }

      function isVoteBump() {
        return request.auth != null
            && resource.data.get('closed', false) == false
            && resource.data.get('answer', '') == ''
            && onlyTally()
            && bumpedOne()
            && matchesMyVote()
            && poolMatches(pid);
      }

      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || isVoteBump();
    }

    // ── 錢包與下注 ──
    // 下注是一個批次：寫注單、扣自己的餘額、加彩池與票數。餘額是由瀏覽器
    // 寫進去的，所以規則必須自己驗算術，否則開個 Console 就能改成一億。
    //
    // 綁定的方式：扣款時錢包會同時寫下 lastBet（這次押的是哪個預測），
    // 規則就能找到對應的注單、比對金額；注單那邊反過來確認錢包的 lastBet
    // 指向自己。兩邊互相指，少一邊就過不了。
    match /wallets/{uid} {
      // 自己的看得到就好；站長要結算發錢，所以全部讀得到
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      // 站長負責結算發錢
      allow write: if isOwner();
      // 新帳號只能開自己的，起始籌碼固定
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'balance', 'createdAt'])
        && request.resource.data.balance == 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16;
      // 本人只能做兩件事：扣掉剛剛那張注單的金額，或領測驗獎金（一天三次）
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (isBetDeduction(uid) || isQuizClaim());
    }

    match /bets/{bid} {
      // 注單帶著玩家取的名字，不讓任何人整包撈走；站長要結算所以讀得到
      allow read: if isOwner()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isOwner();
      allow create: if validBet(bid);
    }

    // 舊的匿名投票。現在下注一律走 bets，這裡不再有人寫，
    // 所以 create 直接關掉——留著就只是多一塊沒人用的攻擊面。
    // 資料保留，歷來統計還接得上。
    match /votes/{vid} {
      allow read: if isOwner()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update, delete: if isOwner();
    }
  }
}
